# NIRIKSHAN local/demo defaults
NODE_ENV=development
PORT=4000
# Production only: use a random secret with 32+ characters.
JWT_SECRET=local-development-only-nirikshan-secret-please-change
# Production only: JSON array of application users. Demo accounts are used when this is omitted in development.
# NIRIKSHAN_USERS_JSON=[{"id":"officer-1","username":"officer","password":"change-this","role":"officer"}]
# Production only: exact public frontend origin(s), comma-separated.
# CORS_ORIGIN=http://localhost:4000
NIRIKSHAN_DATA_DIR=./runtime
